# Copie para .env e preencha. O .env NAO vai para o git.

# --- Veeam ONE (somente leitura; papel "Veeam ONE Read-Only User") ---
VEEAM_ONE_URL=https://veeam-one.exemplo.local:1239
VEEAM_USUARIO=DOMINIO\svc_relatorio_veeam
VEEAM_SENHA=
VEEAM_ONE_API_VERSAO=v2.3
VEEAM_VERIFICAR_SSL=false
VEEAM_TIMEOUT_SEGUNDOS=60

# --- SCP (Sangfor Cloud Platform) — assinatura EC2 (AK/SK), mesmas do scp-console ---
SCP_BASE_URL=https://10.0.0.1
SCP_ACCESS_KEY=
SCP_SECRET_KEY=
SCP_REGION=cn-south-1
SCP_SERVICE=open-api

# --- Relatório (opcionais) ---
# RELATORIO_DIAS_PERIODO=30      # janela de alarmes e de job ativo/inativo
# RELATORIO_HORAS_ALERTA=36      # último backup acima disso fica amarelo
# RELATORIO_DIAS_CRITICO=7       # acima disso fica vermelho
# RELATORIO_PASTA_SAIDA=relatorios
